{
  "name": "jarvis-assistant",
  "version": "1.0.1",
  "description": "JARVIS Assistant - AI chat and voice companion",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abdulrahman50ab/jarvis.git"
  },
  "scripts": {
    "start": "node dev-runner.js",
    "dev": "node dev-runner.js",
    "test": "node smoke-test.js",
    "test:smoke": "node smoke-test.js",
    "build": "npm run build:website",
    "build:website": "node build-website.js",
    "build:web": "npm run build:website",
    "package-win": "npm run build:website && electron-builder --win",
    "package-mac": "npm run build:website && electron-builder --mac",
    "package-linux": "npm run build:website && electron-builder --linux",
    "package-all": "npm run build:website && electron-builder -wml"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jarvis.assistant",
    "productName": "JARVIS Assistant",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Abdulrahman50ab",
        "repo": "jarvis"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "icons/**/*"
    ],
    "extraResources": [
      {
        "from": "../website/out",
        "to": "website",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
